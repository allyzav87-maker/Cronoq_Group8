            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".teacheracceptedmeeting"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".teacherdeclinedmeeting"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".teacherstatus"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".LOGIN"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
